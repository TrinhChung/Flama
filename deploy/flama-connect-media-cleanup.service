[Unit]
Description=Remove expired Flama Connect media and crash leftovers
After=network-online.target mysql.service

[Service]
Type=oneshot
User=flama
Group=flama
WorkingDirectory=/opt/flama/current
EnvironmentFile=/etc/flama/flama.env
ExecStart=/opt/flama/venv/bin/flask --app connect_wsgi:app cleanup-connect-media
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
