[Unit]
Description=Flama Nihongo Gunicorn application
After=network-online.target mysql.service redis-server.service
Wants=network-online.target redis-server.service
Requires=mysql.service

[Service]
Type=simple
User=flama
Group=flama
WorkingDirectory=/opt/flama/current
EnvironmentFile=/etc/flama/flama.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/flama/venv/bin/gunicorn --workers 2 --threads 4 --worker-class gthread --timeout 120 --bind 0.0.0.0:4789 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=150
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/flama

# Priority & Resource Control
Nice=5
CPUWeight=100

[Install]
WantedBy=multi-user.target
