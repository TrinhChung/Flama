[Unit]
Description=Refresh Flama configured learner deck count snapshots
After=network-online.target mysql.service

[Service]
Type=oneshot
User=flama
Group=flama
WorkingDirectory=/opt/flama/current
EnvironmentFile=/etc/flama/flama.env
Environment=STARTUP_RUN_MAINTENANCE=0
Environment=STARTUP_CHECK_DB_CONNECTIVITY=0
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=flama-analytics-counts
ExecStart=/usr/bin/flock --nonblock /run/flama-analytics-counts/runner.lock /opt/flama/venv/bin/flask --app wsgi.py deck-counts-prewarm --configured --apply
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/flama /run/flama-analytics-counts
