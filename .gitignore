# Python cache
__pycache__/
*.py[cod]

# Virtual environments
myenv/
.venv/
venv/
env/

# Environment variables
.env
static/tmp/
/static/uploads/*
!/static/uploads/.gitignore
/static/downloads/*
!/static/downloads/.gitignore
static/strokes/**/*.svg
static/strokes/*.svg
/flama_media_storage/
/output/
/.playwright-cli/

# Production signing credentials and certificate material
*.pfx
*.p12
*.pvk
*.key
*.pem
*.cer
*.crt


/migrations/*
!/migrations/README
!/migrations/env.py
!/migrations/alembic.ini
!/migrations/script.py.mako
!/migrations/versions/
!/migrations/versions/*.py

/app/static/

# Node & Package Managers
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# Agent, Tooling & Plugin metadata
.agent/
.agents/
.stitch/
.impeccable/
plugins/

# External agent skills in skills/ (preserve repo-local skills: docs-architect, nihongo-agent-architect, flama-database-architecture)
skills/*
!skills/docs-architect/
!skills/nihongo-agent-architect/
!skills/flama-database-architecture/
!skills/antigravity-cli/
!skills/antigravity-manager-api/


# OS / Editor files
.DS_Store
Thumbs.db
