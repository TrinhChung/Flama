# .github/workflows/deploy-frontend.yml injects these public values from the
# Flama GitHub Environment while running `npm run build:ci`.
# Replace the example host with the public Flask backend origin.
VITE_API_BASE_URL=https://api.example.com/api
VITE_FLAMA_CONNECT_URL=https://flama-connect.stmtp.com/v1/flama-connect
# Cloudflare Pages publishing (GitHub Environment secret/variables, not Vite)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

