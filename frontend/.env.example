# Local development keeps API calls on the Vite origin and proxies /api to Flask.
VITE_API_BASE_URL=/api
# Production may use the main Flama domain through a narrow reverse-proxy path.
VITE_FLAMA_CONNECT_URL=http://127.0.0.1:4790/v1/flama-connect
# Canary writer for split IndexedDB checkpoints; rebuild to change this flag.
# Keep 0 for rollout/rollback with the new reader; pre-change DB2 bundles cannot read DB3.
VITE_STUDY_SPLIT_STORAGE_ENABLED=0
# Media base origin (e.g. https://media.flama.vn in production or leave empty/set in dev)
VITE_MEDIA_BASE_URL=https://media.flama.vn
