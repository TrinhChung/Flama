# Local development keeps API calls on the Vite origin and proxies them to Flask.
VITE_API_BASE_URL=/api/v1

# Leave this empty for same-origin/local builds. Set an absolute origin when the
# frontend and Flask backend are deployed on different origins.
VITE_BACKEND_ORIGIN=

# Used only by the Vite development proxy. This value is not the production API URL.
VITE_FLASK_ORIGIN=http://127.0.0.1:4789
