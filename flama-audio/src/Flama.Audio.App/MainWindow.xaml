<Window x:Class="Flama.Audio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flama.Audio.App"
        mc:Ignorable="d"
        Title="Flama Audio Local Service" Height="540" Width="740"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" Background="#FFF7F0"
        Foreground="#1F1A17">
    <Window.Resources>
        <!-- Flama Brand Primary Flame Gradient (From Web Design Tokens) -->
        <LinearGradientBrush x:Key="FlamaBrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EF3303" Offset="0"/>
            <GradientStop Color="#FE6808" Offset="0.55"/>
            <GradientStop Color="#FEA00E" Offset="1"/>
        </LinearGradientBrush>

        <!-- Flame Logo Gradient -->
        <LinearGradientBrush x:Key="FlameLogoGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#EF3303" Offset="0"/>
            <GradientStop Color="#FE6808" Offset="0.6"/>
            <GradientStop Color="#FEA00E" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Primary Style (Flama Flame Orange) -->
        <Style x:Key="FlamaPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FlamaBrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Secondary Style (Warm Web Secondary) -->
        <Style x:Key="FlamaSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF1E7"/>
            <Setter Property="Foreground" Value="#B74B06"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FEA46B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Flama Logo -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Flama logo.png Image Container -->
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="#FFFFFF" BorderBrush="#E9DDD4" BorderThickness="1" Margin="0,0,14,0" Padding="5">
                <Border.Effect>
                    <DropShadowEffect Color="#1F1A17" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <Image Source="Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FLAMA" FontSize="22" FontWeight="Black" Foreground="#1F1A17"/>
                    <TextBlock Text="AUDIO" FontSize="22" FontWeight="Black" Foreground="#FE6808" Margin="6,0,0,0"/>
                    <Border Background="#FFF3EB" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderBrush="#FEA46B" BorderThickness="1">
                        <TextBlock Text="LOCAL TTS SERVICE" FontSize="10" FontWeight="Bold" Foreground="#E05C07"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Trợ lý tổng hợp phát âm Tiếng Nhật local &amp; Quản lý Engine VOICEVOX" FontSize="12" Foreground="#6B625C" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="18" Margin="0,0,0,20" BorderBrush="#E9DDD4" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1F1A17" BlurRadius="12" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#16A34A" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#16A34A" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Local Endpoint Service Active" FontWeight="Bold" FontSize="13" Foreground="#15803D"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                        <Border Background="#FFF1E7" CornerRadius="6" Padding="8,4" BorderBrush="#E9DDD4" BorderThickness="1">
                            <TextBlock Text="http://127.0.0.1:4791" FontSize="12" Foreground="#E05C07" FontFamily="Consolas" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="• CORS &amp; Private Network Access Ready" FontSize="11" Foreground="#6B625C" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Làm mới" Click="OnRefreshClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Split Panel: Pairings & Engines -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pairing Panel -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="#E9DDD4" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#1F1A17" BlurRadius="12" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Yêu cầu Ghép nối (Pairing Requests)" FontWeight="Bold" FontSize="14" Foreground="#1F1A17"/>
                        <TextBlock Text="Phê duyệt các kết nối từ Flama Web Client" FontSize="11" Foreground="#6B625C" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="PairingListBox" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF1E7" Padding="12" CornerRadius="8" Margin="0,0,0,8" BorderBrush="#E9DDD4" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Origin}" FontWeight="Bold" FontSize="13" Foreground="#1F1A17"/>
                                            <TextBlock Text="{Binding ClientInfo}" FontSize="11" Foreground="#6B625C" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Phê duyệt" Tag="{Binding PairingId}" Click="OnApprovePairingClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" Padding="10,5" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Engines Panel -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="#E9DDD4" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#1F1A17" BlurRadius="12" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="TTS Engine Management" FontWeight="Bold" FontSize="14" Foreground="#1F1A17"/>
                        <TextBlock Text="Cấu hình &amp; khởi chạy VOICEVOX Engine local" FontSize="11" Foreground="#6B625C" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <Border Background="#FFF1E7" BorderBrush="#E9DDD4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="VOICEVOX Engine" FontWeight="Bold" FontSize="13" Foreground="#1F1A17"/>
                                    <Border Background="#FFF3EB" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" BorderBrush="#FEA46B" BorderThickness="1">
                                        <TextBlock Text="Japanese CPU" FontSize="10" FontWeight="Bold" Foreground="#E05C07"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="EngineStatusTextBlock" Text="Trạng thái: Đang kiểm tra Port 50021..." FontSize="12" Foreground="#6B625C" Margin="0,6,0,6"/>
                                
                                <ProgressBar x:Name="EngineProgressBar" Height="4" Margin="0,2,0,10" Visibility="Collapsed" IsIndeterminate="True" Foreground="{StaticResource FlamaBrandGradient}"/>

                                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                    <Button x:Name="BtnInstallEngine" Content="⚡ Tải &amp; Tự động cài VOICEVOX Engine" Click="OnInstallEngineClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                    <Button x:Name="BtnLaunchEngine" Content="🚀 Bật VOICEVOX Engine đã có" Click="OnLaunchEngineClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Flama Audio v1.0.0 • Auto Engine Supervisor • .NET 8 LTS" FontSize="11" Foreground="#6B625C" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
