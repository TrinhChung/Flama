<Window x:Class="Flama.Audio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flama.Audio.App"
        mc:Ignorable="d"
        Title="Flama Audio Local Service" Height="640" Width="820"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" Background="#FFF7F0"
        Foreground="#1F1A17">
    <Window.Resources>
        <!-- Flama Brand Primary Flame Gradient -->
        <LinearGradientBrush x:Key="FlamaBrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EF3303" Offset="0"/>
            <GradientStop Color="#FE6808" Offset="0.55"/>
            <GradientStop Color="#FEA00E" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Primary Style (Flama Flame Orange) -->
        <Style x:Key="FlamaPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FlamaBrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Secondary Style (Warm Web Secondary) -->
        <Style x:Key="FlamaSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF1E7"/>
            <Setter Property="Foreground" Value="#B74B06"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FEA46B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Nav Button Active Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F1A17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#FEA46B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Top Main Menu Bar (WPF Menu) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Menu Background="Transparent" Foreground="#1F1A17" FontSize="11" FontWeight="SemiBold">
                <MenuItem Header="📁 Tệp (File)">
                    <MenuItem Header="📁 Mở Thư mục Log..." Click="OnOpenLogFolderClicked"/>
                    <Separator/>
                    <MenuItem Header="❌ Thoát" Click="OnExitClicked"/>
                </MenuItem>
                <MenuItem Header="🛠️ Công cụ (Tools)">
                    <MenuItem Header="📋 Xem Log Nhật ký &amp; Lỗi Debug..." Click="OnNavLogsClicked"/>
                    <MenuItem Header="🔄 Làm mới dữ liệu" Click="OnRefreshClicked"/>
                </MenuItem>
                <MenuItem Header="❓ Trợ giúp (Help)">
                    <MenuItem Header="🌐 Trang chủ Flama Web" Click="OnOpenWebClicked"/>
                    <Separator/>
                    <MenuItem Header="ℹ️ Về Flama Audio MVP" Click="OnAboutClicked"/>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Row 1: Header with Flama Logo & Debug Log Button -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Flama logo -->
            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#FFFFFF" BorderBrush="#E9DDD4" BorderThickness="1" Margin="0,0,12,0" Padding="4">
                <Border.Effect>
                    <DropShadowEffect Color="#1F1A17" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <Image Source="Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FLAMA" FontSize="20" FontWeight="Black" Foreground="#1F1A17"/>
                    <TextBlock Text="AUDIO" FontSize="20" FontWeight="Black" Foreground="#FE6808" Margin="5,0,0,0"/>
                    <Border Background="#FFF3EB" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#FEA46B" BorderThickness="1">
                        <TextBlock Text="BỘ PHÁT ÂM OFFLINE" FontSize="10" FontWeight="Bold" Foreground="#E05C07"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Trợ lý phát âm offline đa ngôn ngữ cho từ điển học tập" FontSize="11" Foreground="#6B625C" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Endpoint Status Indicator -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFFFFF" CornerRadius="8" Padding="10,6" BorderBrush="#E9DDD4" BorderThickness="1" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0"/>
                        <TextBlock Text="Cổng kết nối: 127.0.0.1:4791" FontSize="11" Foreground="#E05C07" FontFamily="Segoe UI" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Button Content="🔄 Làm mới" Click="OnRefreshClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" Padding="10,5"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Global Navigation Tabs (Cleaned to 3 main tabs) -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="6" Margin="0,0,0,14" BorderBrush="#E9DDD4" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnNavInstalled" Grid.Column="0" Content="⚡ Giọng đọc sẵn sàng" Click="OnNavInstalledClicked" Style="{StaticResource NavTabButtonStyle}" Margin="2"/>
                <Button x:Name="BtnNavUninstalled" Grid.Column="1" Content="📥 Tải giọng đọc mới" Click="OnNavUninstalledClicked" Style="{StaticResource NavTabButtonStyle}" Margin="2"/>
                <Button x:Name="BtnNavPairing" Grid.Column="2" Content="🔗 Kết nối trình duyệt" Click="OnNavPairingClicked" Style="{StaticResource NavTabButtonStyle}" Margin="2"/>
            </Grid>
        </Border>

        <!-- Row 3: View Title / Status Banner -->
        <Border Grid.Row="3" Background="#FFF3EB" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="#FEA46B" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="ViewTitleTextBlock" Text="Quản lý giọng đọc phát âm" FontWeight="Bold" FontSize="12" Foreground="#E05C07" VerticalAlignment="Center"/>
                <Button x:Name="BtnBackToList" Content="← Quay lại danh sách" Click="OnBackToListClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" HorizontalAlignment="Right" Visibility="Collapsed" Padding="8,3" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Row 4: Dynamic Views Container -->
        <Grid Grid.Row="4">

            <!-- VIEW 1: Installed Engines List -->
            <ScrollViewer x:Name="ViewInstalledEngines" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel x:Name="InstalledEnginesContainer">
                    
                    <!-- VOICEVOX Engine Card -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E9DDD4" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#1F1A17" BlurRadius="8" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🇯🇵 Giọng đọc Tiếng Nhật (VOICEVOX)" FontWeight="Bold" FontSize="14" Foreground="#1F1A17"/>
                                    <Border Background="#FFF1E7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" BorderBrush="#FEA46B" BorderThickness="1">
                                        <TextBlock Text="Tiếng Nhật (Giọng tự nhiên)" FontSize="10" FontWeight="Bold" Foreground="#E05C07"/>
                                    </Border>
                                    <Border x:Name="VoicevoxStatusBadge" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" BorderBrush="#86EFAC" BorderThickness="1">
                                        <TextBlock x:Name="VoicevoxStatusBadgeText" Text="🟢 Sẵn sàng" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="VoicevoxDetailTextBlock" Text="Trạng thái: Đang kết nối..." FontSize="11" Foreground="#6B625C" Margin="0,6,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnLaunchVoicevox" Content="🚀 Khởi động giọng đọc" Click="OnLaunchVoicevoxClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,5"/>
                                    <Button Content="🔊 Thử giọng &amp; Chi tiết" Tag="voicevox" Click="OnOpenEngineDetailClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" Padding="12,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Kokoro-82M Engine Card -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E9DDD4" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#1F1A17" BlurRadius="8" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🇺🇸/🌐 Giọng đọc Đa Ngôn Ngữ (Kokoro AI)" FontWeight="Bold" FontSize="14" Foreground="#1F1A17"/>
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" BorderBrush="#93C5FD" BorderThickness="1">
                                        <TextBlock Text="Đa ngôn ngữ (Giọng đọc AI)" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </Border>
                                    <Border x:Name="KokoroStatusBadge" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" BorderBrush="#86EFAC" BorderThickness="1">
                                        <TextBlock x:Name="KokoroStatusBadgeText" Text="🟢 Sẵn sàng" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="KokoroDetailTextBlock" Text="Bộ phát âm AI chất lượng cao" FontSize="11" Foreground="#6B625C" Margin="0,6,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔊 Thử giọng &amp; Chi tiết" Tag="kokoro" Click="OnOpenEngineDetailClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" Padding="12,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 2: Engine Detail & Live Voice Tester -->
            <ScrollViewer x:Name="ViewEngineDetail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10">
                    
                    <!-- Engine Summary Header Card -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E9DDD4" BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailEngineTitle" Text="Engine Name" FontWeight="Bold" FontSize="16" Foreground="#1F1A17"/>
                                    <Border x:Name="DetailEngineBadge" Background="#FFF1E7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" BorderBrush="#FEA46B" BorderThickness="1">
                                        <TextBlock x:Name="DetailEngineBadgeText" Text="Language" FontSize="10" FontWeight="Bold" Foreground="#E05C07"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="DetailEngineDescription" Text="Description..." FontSize="11" Foreground="#6B625C" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Built-in Voice Tester Card -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="18" BorderBrush="#FEA46B" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#1F1A17" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🔊 Thử nghiệm Giọng đọc Trực tiếp (Voice Tester)" FontWeight="Bold" FontSize="13" Foreground="#E05C07" Margin="0,0,0,12"/>

                            <!-- Language Selector -->
                            <TextBlock Text="Chọn Ngôn ngữ (Language):" FontSize="11" FontWeight="SemiBold" Foreground="#1F1A17" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TestLanguageComboBox" Height="32" Margin="0,0,0,12" FontSize="12" Padding="6,2" SelectionChanged="OnTestLanguageChanged"/>

                            <!-- Voice Selector -->
                            <TextBlock Text="Chọn Giọng đọc / Nhân vật:" FontSize="11" FontWeight="SemiBold" Foreground="#1F1A17" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TestVoiceComboBox" Height="32" Margin="0,0,0,12" FontSize="12" Padding="6,2"/>

                            <!-- Sample Text Input -->
                            <TextBlock Text="Văn bản thử nghiệm (Sample Text):" FontSize="11" FontWeight="SemiBold" Foreground="#1F1A17" Margin="0,0,0,4"/>
                            <TextBox x:Name="TestSampleTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" Padding="8" Margin="0,0,0,12" Background="#FFF7F0" BorderBrush="#E9DDD4" BorderThickness="1"/>

                            <!-- Speed Slider -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tốc độ đọc:" FontSize="11" FontWeight="SemiBold" Foreground="#1F1A17" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" x:Name="TestSpeedSlider" Minimum="0.5" Maximum="2.0" Value="1.0" SmallChange="0.1" LargeChange="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnTestSpeedSliderChanged"/>
                                <TextBlock Grid.Column="2" x:Name="TestSpeedValueText" Text="1.0x" FontSize="11" FontWeight="Bold" Foreground="#E05C07" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Play Action Button & Status -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPlayVoiceTest" Content="🔊 Phát âm thử ngay" Click="OnPlayVoiceTestClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" Padding="16,8" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TestStatusText" Text="" FontSize="11" Foreground="#6B625C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 3: Uninstalled Engines List -->
            <ScrollViewer x:Name="ViewUninstalledEngines" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    
                    <TextBlock x:Name="UninstalledEmptyText" Text="🎉 Tất cả các Engine TTS hiện tại đã được cài đặt đầy đủ!" FontSize="13" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

                    <!-- Kokoro Install Card -->
                    <Border x:Name="KokoroInstallCard" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E9DDD4" BorderThickness="1" Visibility="Visible">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🇺🇸 Kokoro-82M English Neural Engine" FontWeight="Bold" FontSize="14" Foreground="#1F1A17"/>
                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" BorderBrush="#93C5FD" BorderThickness="1">
                                    <TextBlock Text="Weights ~120MB" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Mô hình tổng hợp giọng đọc tiếng Anh Kokoro-82M (INT8 ONNX model + 54 voice style embeddings). Tải 1 lần dùng mãi mãi hoàn toàn offline." FontSize="11" Foreground="#6B625C" Margin="0,4,0,10"/>
                            
                            <ProgressBar x:Name="KokoroInstallProgressBar" Height="4" Margin="0,0,0,10" Visibility="Collapsed" Foreground="{StaticResource FlamaBrandGradient}"/>

                            <Button x:Name="BtnInstallKokoro" Content="⚡ Tải &amp; Cài đặt Kokoro Engine (~120MB)" Click="OnInstallKokoroClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- VOICEVOX Install Card -->
                    <Border x:Name="VoicevoxInstallCard" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E9DDD4" BorderThickness="1" Visibility="Visible">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🇯🇵 VOICEVOX Japanese CPU Engine" FontWeight="Bold" FontSize="14" Foreground="#1F1A17"/>
                                <Border Background="#FFF1E7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" BorderBrush="#FEA46B" BorderThickness="1">
                                    <TextBlock Text="Standalone Package" FontSize="10" FontWeight="Bold" Foreground="#E05C07"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Bộ cài phát âm tiếng Nhật VOICEVOX Engine Standalone CPU. Tự động tải và cấu hình chạy ngầm trên port 50021." FontSize="11" Foreground="#6B625C" Margin="0,4,0,10"/>

                            <ProgressBar x:Name="VoicevoxInstallProgressBar" Height="4" Margin="0,0,0,10" Visibility="Collapsed" Foreground="{StaticResource FlamaBrandGradient}"/>

                            <Button x:Name="BtnInstallVoicevox" Content="⚡ Tải &amp; Tự động cài VOICEVOX Engine" Click="OnInstallVoicevoxClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 4: Pairing Requests -->
            <ScrollViewer x:Name="ViewPairing" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Border Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="#E9DDD4" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Yêu cầu Ghép nối (Pairing Requests)" FontWeight="Bold" FontSize="14" Foreground="#1F1A17"/>
                            <TextBlock Text="Phê duyệt các kết nối từ Flama Web Client để cấp quyền tổng hợp audio local." FontSize="11" Foreground="#6B625C" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="PairingListBox" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF1E7" Padding="12" CornerRadius="8" Margin="0,0,0,8" BorderBrush="#E9DDD4" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Origin}" FontWeight="Bold" FontSize="13" Foreground="#1F1A17"/>
                                                <TextBlock Text="{Binding ClientInfo}" FontSize="11" Foreground="#6B625C" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Phê duyệt" Tag="{Binding PairingId}" Click="OnApprovePairingClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" Padding="10,5" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </ScrollViewer>

            <!-- VIEW 5: Logs & Debugger View (Accessible via Top Menu) -->
            <Grid x:Name="ViewLogs" Visibility="Collapsed">
                <Border Background="#FFFFFF" CornerRadius="12" Padding="14" BorderBrush="#E9DDD4" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Log Toolbar with Quick Copy Buttons -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="📋 Copy Toàn bộ Log" Click="OnCopyAllLogsClicked" Style="{StaticResource FlamaPrimaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" FontSize="11"/>
                                <Button Content="🚨 Copy Log Lỗi" Click="OnCopyErrorLogsClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" FontSize="11"/>
                                <Button Content="📁 Mở Thư mục Log" Click="OnOpenLogFolderClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" FontSize="11"/>
                                <Button Content="🗑️ Xóa Log UI" Click="OnClearLogsClicked" Style="{StaticResource FlamaSecondaryButtonStyle}" Padding="8,5" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Lọc Mức Log:" FontSize="11" FontWeight="Bold" Foreground="#1F1A17" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="LogFilterComboBox" Height="28" Width="130" FontSize="11" SelectionChanged="OnLogFilterChanged">
                                    <ComboBoxItem Content="Tất cả (All)" IsSelected="True" Tag="All"/>
                                    <ComboBoxItem Content="🚨 Lỗi (Errors Only)" Tag="Error"/>
                                    <ComboBoxItem Content="⚠️ Cảnh báo (Warnings)" Tag="Warning"/>
                                    <ComboBoxItem Content="ℹ️ Thông tin (Info)" Tag="Info"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>

                        <!-- Monospace Selectable Logs TextBox -->
                        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="10" BorderBrush="#333333" BorderThickness="1">
                            <TextBox x:Name="LogOutputTextBox" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
