<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Flama.Audio.Core\Flama.Audio.Core.csproj" />
    <ProjectReference Include="..\Flama.Audio.Infrastructure\Flama.Audio.Infrastructure.csproj" />
    <ProjectReference Include="..\Flama.Audio.Engine.Voicevox\Flama.Audio.Engine.Voicevox.csproj" />
    <ProjectReference Include="..\Flama.Audio.Engine.Kokoro\Flama.Audio.Engine.Kokoro.csproj" />
    <ProjectReference Include="..\Flama.Audio.Engine.EdgeTts\Flama.Audio.Engine.EdgeTts.csproj" />
    <ProjectReference Include="..\Flama.Audio.Api\Flama.Audio.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>FlamaAudio</AssemblyTitle>
    <Product>FlamaAudio</Product>
    <Description>FlamaAudio</Description>
    <Company>Flama</Company>
    <Copyright>Copyright © Flama</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>

</Project>
