FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=replace-me-with-a-secret-value
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=flama
# Historical analytics: enable writers on every process after migration 51,
# backfill/verify, then canary summary reads. Raw is the rollback switch.
REVIEW_ANALYTICS_WRITE_ENABLED=0
REVIEW_ANALYTICS_READ_MODE=raw
REVIEW_ANALYTICS_READ_USER_IDS=1
REVIEW_ANALYTICS_SHADOW_SAMPLE_RATE=0.01
# Empty fingerprints the installed timezone rules; override only when managed.
REVIEW_ANALYTICS_TIMEZONE_RULES_VERSION=
DECK_COUNT_WRITE_ENABLED=0
DECK_COUNT_READ_MODE=raw
DECK_COUNT_PREWARM_USER_IDS=1
# Due buckets require migration 64 and covered deck-count writers. Prewarm
# and compare exact raw payloads before enabling canary summary reads.
FORECAST_SUMMARY_READ_MODE=raw
FORECAST_SUMMARY_READ_USER_IDS=1
# Migration 67 requires the verified offline Field ID cutover. Live Note
# values then have one canonical ID store; there is no dual-write flag.
# Optional exact-read canary: missing summaries return 409 + Retry-After;
# raw/shadow recovery stays available. Empty preserves the existing fallback.
ANALYTICS_REQUIRE_READY_USER_IDS=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional fallback URL used only when the server has no Flama Audio portable EXE.
FLAMA_AUDIO_DOWNLOAD_URL=
# Optional HTTPS fallback for the matching CI-generated SHA-256 sidecar.
FLAMA_AUDIO_CHECKSUM_URL=
# Flama Connect is a token-authenticated Yomitan compatibility endpoint.
# Browser-extension origins vary, so "*" means echo the requesting extension
# origin; the main web frontend never sends its login session here.
CONNECT_CORS_ALLOWED_ORIGINS=*
CONNECT_TRUST_PROXY=0
CONNECT_LEGACY_WEB_ACTIONS_ENABLED=0
# Standard contract is enabled separately; leave legacy wire cutover off until
# raw-v5/v6 callers have been inventoried. Standard origins never allow '*'.
CONNECT_ANKI_ADAPTER_ENABLED=0
CONNECT_ANKI_MEDIA_ENABLED=0
CONNECT_VERSIONED_PROTOCOL_ENABLED=0
CONNECT_ANKI_ALLOWED_ORIGINS=https://killergerbah.github.io
CONNECT_ANKI_MAX_CONTENT_LENGTH=6291456
CONNECT_ANKI_MEDIA_MAX_BYTES=2097152
CONNECT_ANKI_NOTE_MEDIA_MAX_BYTES=4194304
CONNECT_ANKI_PENDING_MAX_BYTES=16777216
# Connect admission cap; other media APIs do not yet share quota reservations.
CONNECT_ANKI_STORAGE_MAX_BYTES=536870912
# Set redis on public/multi-worker deployments. local is for development only.
CONNECT_RATE_LIMIT_BACKEND=local
CONNECT_MAX_CONTENT_LENGTH=2097152
CONNECT_RATE_LIMIT_WINDOW_SECONDS=60
CONNECT_IP_RATE_LIMIT=120
CONNECT_INVALID_TOKEN_RATE_LIMIT=10
CONNECT_TOKEN_RATE_LIMIT=60
CONNECT_USER_RATE_LIMIT=120
CONNECT_ADD_NOTE_RATE_LIMIT=20
CONNECT_MEDIA_RATE_LIMIT=20
CONNECT_MEDIA_MAX_BYTES=1048576
CONNECT_IMPORT_MEDIA_MAX_BYTES=10485760
CONNECT_IMPORT_MEDIA_MAX_ITEMS=20000
CONNECT_PACKAGE_MAX_BYTES=16777216
CONNECT_PACKAGE_MAX_ENTRIES=500
CONNECT_PACKAGE_MAX_UNCOMPRESSED_BYTES=67108864
CONNECT_PACKAGE_MAX_COMPRESSION_RATIO=100
CONNECT_CARD_PACKAGE_TARGET_ITEMS=500
CONNECT_CARD_PACKAGE_MAX_ITEMS=1000
CONNECT_PACKAGE_RATE_LIMIT=30

# Shared state for multi-worker Gunicorn. Keep local during rollout, switch to
# shadow_redis, then redis after Redis health/fallback metrics are clean.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
# Continuous Study workers require an explicit namespace shared with the web
# app. Empty preserves the old manual/test queue and cannot advertise readiness.
STUDY_QUEUE_NAMESPACE=
# Real admission also requires shared worker readiness; opt in after validation.
STUDY_ASYNC_BATCH_ENABLED=0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_KEY_PREFIX=flama:v1
RATE_LIMIT_HMAC_KEY=
MCP_PREVIEW_BACKEND=redis
MCP_PREVIEW_TTL_SECONDS=600
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=300
# Usage quotas for Connect API, MCP tool calls and media uploads. Limits, periods and
# monitor/enforce mode are set on /admin/quotas; web app requests are never counted.
# false turns quota counting off entirely. The timezone sets day/month/year boundaries.
RATE_LIMIT_DAILY_ENABLED=true
RATE_LIMIT_DAILY_TIMEZONE=Asia/Ho_Chi_Minh
# Keep disabled until the MCP burst threshold has been load-tested. When
# enabled, RATE_LIMIT_BACKEND=redis makes this quota global across workers.
MCP_TOKEN_RATE_LIMIT_ENABLED=false
MCP_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60
MCP_TOKEN_RATE_LIMIT_MAX_REQUESTS=100000

# Post-P0 marketplace cutovers.
SHARED_DECK_TREE_CLONE_MODE=batched
DECK_SOURCE_NOTETYPE_GUARD_MODE=shadow
MARKETPLACE_SAMPLE_MODE=shadow_cache

# Bound database connections per Gunicorn worker (2 workers remain the canary).
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
FLASHCARD_RENDER_PREVIEW_CACHE_MAX_ENTRIES=512
CONNECT_PENDING_MEDIA_TTL_SECONDS=1800
CONNECT_PENDING_MEDIA_MAX_ITEMS=20
CONNECT_PENDING_MEDIA_MAX_TOTAL_BYTES=10485760
USE_NEW_CARD_MODEL=false
FLASHCARD_MEDIA_UPLOAD_ROOT=../flama_media_storage
FLASHCARD_MEDIA_MAX_BYTES=10485760
# Enable only after the Nginx /internal-media/ location is installed.
MEDIA_PROXY_USE_XACCEL=0
IMAGE_LIBRARY_MAX_BYTES=5242880
IMAGE_LIBRARY_MAX_PIXELS=25000000
IMAGE_LIBRARY_REMOTE_FETCH_TIMEOUT_SECONDS=6
IMAGE_LIBRARY_REMOTE_FETCH_MAX_REDIRECTS=3
FLASHCARDS_SHARE_CUTOVER_FAIL_ON_MISMATCH=0
# payOS-first payment configuration
PAYMENTS_ENABLED=0
PAYMENTS_PROVIDER=payos
PAYMENTS_PAID_INSTALL_REQUIRED=0
PAYMENTS_WEBHOOK_AUTO_GRANT_ENABLED=0
PAYMENTS_ORDER_EXPIRY_SECONDS=1800
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Transactional email is disabled by default. Live credentials belong only in
# the deployment secret environment, never in this file.
EMAIL_ENABLED=0
EMAIL_PROVIDER=disabled
EMAIL_ENVIRONMENT=local
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Flama
EMAIL_REPLY_TO=
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_REDIRECT_ALL_TO=
EMAIL_RESEND_API_KEY=
# SMTP settings (e.g. for smtp.gmail.com with App Password)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_PROVIDER_TIMEOUT_SECONDS=10
EMAIL_PROVIDER_MAX_ATTEMPTS=2
EMAIL_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
PUBLIC_APP_URL=http://127.0.0.1:5173
# Enable inline MCP preview after validating nested sandbox support in the host.
# Text/structured preview remains available when this is disabled.
MCP_TEMPLATE_PREVIEW_UI_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3

# Media cache deployment helper (production flama.vn zone)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
