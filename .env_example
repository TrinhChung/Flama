FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=replace-me-with-a-secret-value
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=flama
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional fallback URL used only when the server has no Flama Audio portable EXE.
FLAMA_AUDIO_DOWNLOAD_URL=
# Optional HTTPS fallback for the matching CI-generated SHA-256 sidecar.
FLAMA_AUDIO_CHECKSUM_URL=
# Flama Connect is a token-authenticated Yomitan compatibility endpoint.
# Browser-extension origins vary, so "*" means echo the requesting extension
# origin; the main web frontend never sends its login session here.
CONNECT_CORS_ALLOWED_ORIGINS=*
CONNECT_TRUST_PROXY=0
CONNECT_LEGACY_WEB_ACTIONS_ENABLED=0
CONNECT_MAX_CONTENT_LENGTH=2097152
CONNECT_RATE_LIMIT_WINDOW_SECONDS=60
CONNECT_IP_RATE_LIMIT=120
CONNECT_INVALID_TOKEN_RATE_LIMIT=10
CONNECT_TOKEN_RATE_LIMIT=60
CONNECT_USER_RATE_LIMIT=120
CONNECT_ADD_NOTE_RATE_LIMIT=20
CONNECT_MEDIA_RATE_LIMIT=20
CONNECT_MEDIA_MAX_BYTES=1048576
CONNECT_IMPORT_MEDIA_MAX_BYTES=10485760
CONNECT_IMPORT_MEDIA_MAX_ITEMS=20000
CONNECT_PACKAGE_MAX_BYTES=16777216
CONNECT_PACKAGE_MAX_ENTRIES=500
CONNECT_PACKAGE_MAX_UNCOMPRESSED_BYTES=67108864
CONNECT_PACKAGE_MAX_COMPRESSION_RATIO=100
CONNECT_CARD_PACKAGE_TARGET_ITEMS=500
CONNECT_CARD_PACKAGE_MAX_ITEMS=1000
CONNECT_PACKAGE_RATE_LIMIT=30

# Shared state for multi-worker Gunicorn. Keep local during rollout, switch to
# shadow_redis, then redis after Redis health/fallback metrics are clean.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_KEY_PREFIX=flama:v1
RATE_LIMIT_HMAC_KEY=
MCP_PREVIEW_BACKEND=redis
MCP_PREVIEW_TTL_SECONDS=600
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=300
# Daily Role-Based Rate Limiting for API & MCP (Regular: 300/day, Creator: 2000/day, Admin: unlimited)
RATE_LIMIT_DAILY_ENABLED=true
RATE_LIMIT_REGULAR_DAILY_MAX=300
RATE_LIMIT_CREATOR_DAILY_MAX=2000
RATE_LIMIT_ENTERPRISE_DAILY_MAX=10000
RATE_LIMIT_DAILY_TIMEZONE=Asia/Ho_Chi_Minh
# Keep disabled until the MCP burst threshold has been load-tested. When
# enabled, RATE_LIMIT_BACKEND=redis makes this quota global across workers.
MCP_TOKEN_RATE_LIMIT_ENABLED=false
MCP_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60
MCP_TOKEN_RATE_LIMIT_MAX_REQUESTS=100000

# Post-P0 marketplace cutovers.
SHARED_DECK_TREE_CLONE_MODE=batched
DECK_SOURCE_NOTETYPE_GUARD_MODE=shadow
MARKETPLACE_SAMPLE_MODE=shadow_cache

# Bound database connections per Gunicorn worker (2 workers remain the canary).
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
FLASHCARD_RENDER_PREVIEW_CACHE_MAX_ENTRIES=512
CONNECT_PENDING_MEDIA_TTL_SECONDS=1800
CONNECT_PENDING_MEDIA_MAX_ITEMS=20
CONNECT_PENDING_MEDIA_MAX_TOTAL_BYTES=10485760
USE_NEW_CARD_MODEL=false
FLASHCARD_MEDIA_UPLOAD_ROOT=../flama_media_storage
FLASHCARD_MEDIA_MAX_BYTES=10485760
IMAGE_LIBRARY_MAX_BYTES=5242880
IMAGE_LIBRARY_MAX_PIXELS=25000000
IMAGE_LIBRARY_REMOTE_FETCH_TIMEOUT_SECONDS=6
IMAGE_LIBRARY_REMOTE_FETCH_MAX_REDIRECTS=3
FLASHCARDS_SHARE_CUTOVER_FAIL_ON_MISMATCH=0
# payOS-first payment configuration
PAYMENTS_ENABLED=0
PAYMENTS_PROVIDER=payos
PAYMENTS_PAID_INSTALL_REQUIRED=0
PAYMENTS_WEBHOOK_AUTO_GRANT_ENABLED=0
PAYMENTS_ORDER_EXPIRY_SECONDS=1800
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
