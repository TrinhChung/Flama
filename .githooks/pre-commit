#!/usr/bin/env bash
# Pre-commit hook: Auto verify secrets, update REST API route snapshot, and sync skill mirrors

set -e

test_python() {
    "$1" -c "import sys; sys.exit(0)" >/dev/null 2>&1
}

# Find python executable
PYTHON=""
if [ -f ".venv/Scripts/python.exe" ] && test_python ".venv/Scripts/python.exe"; then
    PYTHON=".venv/Scripts/python.exe"
elif [ -f ".venv/bin/python" ] && test_python ".venv/bin/python"; then
    PYTHON=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1 && test_python "python3"; then
    PYTHON="python3"
elif command -v python >/dev/null 2>&1 && test_python "python"; then
    PYTHON="python"
elif command -v py >/dev/null 2>&1 && py -3.12 -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
    PYTHON="py -3.12"
elif command -v py >/dev/null 2>&1 && test_python "py"; then
    PYTHON="py"
else
    echo "[pre-commit] ERROR: Python not found or non-functional; the secret scanner cannot run. Install Python 3 or create .venv." >&2
    exit 1
fi

# 1. Primary Secret Scan: Gitleaks if available
if command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-commit] Running Gitleaks secret scan on staged changes..."
    gitleaks protect --staged --verbose --config=.gitleaks.toml
    echo "[pre-commit] Gitleaks scan passed."
fi

# 2. Portable Fail-Safe Secret Scan: Native Python Scanner (always executed)
$PYTHON scripts/check_secrets_staged.py

# 3. Check if any route/app/model files are staged
STAGED_FILES=$(git diff --cached --name-only)
if echo "$STAGED_FILES" | grep -qE '^(app/|models/|tests/test_api_v1_route_map\.py)'; then
    echo "[pre-commit] Route-affecting files modified in commit. Refreshing API route snapshot..."
    $PYTHON scripts/update_route_snapshot.py
    git add tests/snapshots/api_v1_routes.json
    echo "[pre-commit] API route snapshot verified and auto-staged."
fi

# 4. Keep both repository skill discovery mirrors in step with skills/
if echo "$STAGED_FILES" | grep -qE '^skills/'; then
    echo "[pre-commit] Agent skills modified. Updating Claude Code and Codex repo mirrors..."
    $PYTHON scripts/sync_claude_skills.py --stage
    echo "[pre-commit] Both repository skill mirrors updated and auto-staged."
fi

exit 0
